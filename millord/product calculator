import tkinter as tk
from tkinter import messagebox

# Main Window
window = tk.Tk()
window.title("Product Calculator")
window.geometry("450x600")
window.resizable(False, False)

# Title
tk.Label(
    window,
    text="PRODUCT CALCULATOR",
    font=("Arial", 24, "bold")
).pack(pady=20)

# Product Name
tk.Label(
    window,
    text="Product Name",
    font=("Arial", 14)
).pack()

product_entry = tk.Entry(
    window,
    font=("Arial", 16),
    justify="center"
)
product_entry.pack(pady=8)

# Product Price
tk.Label(
    window,
    text="Price per Product (₱)",
    font=("Arial", 14)
).pack()

price_entry = tk.Entry(
    window,
    font=("Arial", 16),
    justify="center"
)
price_entry.pack(pady=8)

# Quantity
tk.Label(
    window,
    text="Quantity",
    font=("Arial", 14)
).pack()

quantity_entry = tk.Entry(
    window,
    font=("Arial", 16),
    justify="center"
)
quantity_entry.pack(pady=8)


def calculate():
    try:
        product = product_entry.get()
        price = float(price_entry.get())
        quantity = int(quantity_entry.get())

        if product == "":
            messagebox.showerror("Error", "Please enter a product name.")
            return

        if price < 0 or quantity < 1:
            messagebox.showerror(
                "Error",
                "Please enter valid price and quantity."
            )
            return

        total = price * quantity

        product_result.config(
            text=f"Product: {product}"
        )

        total_result.config(
            text=f"Total: ₱{total:,.2f}"
        )

    except ValueError:
        messagebox.showerror(
            "Error",
            "Please enter valid numbers."
        )


def clear():
    product_entry.delete(0, tk.END)
    price_entry.delete(0, tk.END)
    quantity_entry.delete(0, tk.END)

    product_result.config(
        text="Product: ---"
    )

    total_result.config(
        text="Total: ₱0.00"
    )


# Calculate Button
tk.Button(
    window,
    text="CALCULATE",
    font=("Arial", 15, "bold"),
    command=calculate,
    width=18
).pack(pady=20)

# Clear Button
tk.Button(
    window,
    text="CLEAR",
    font=("Arial", 15),
    command=clear,
    width=18
).pack()

# Results
product_result = tk.Label(
    window,
    text="Product: ---",
    font=("Arial", 16)
)
product_result.pack(pady=30)

total_result = tk.Label(
    window,
    text="Total: ₱0.00",
    font=("Arial", 22, "bold")
)
total_result.pack()

window.mainloop()